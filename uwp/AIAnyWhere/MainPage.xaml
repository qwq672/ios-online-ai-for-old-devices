<Page
    x:Class="AIAnyWhere.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:AIAnyWhere"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.Resources>
        <local:BoolToVisibilityConverter x:Key="VisConv"/>
        <local:GridLengthStarConverter x:Key="StarConv"/>
        <!-- v261116-15: UWP 标准侧边栏菜单项样式 — 左侧蓝色竖条 + 半透明背景（不用 RadioButton 圆点） -->
        <Style x:Key="NavListItemStyle" TargetType="ListViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{ThemeResource SystemControlForegroundBaseHighBrush}"/>
            <Setter Property="UseSystemFocusVisuals" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Grid x:Name="Root" Background="{TemplateBinding Background}">
                            <!-- 左侧蓝色竖条（选中时显示，4px 宽，accent 色） -->
                            <Rectangle x:Name="SelectionBar" Width="4" Height="24"
                                       HorizontalAlignment="Left" VerticalAlignment="Center"
                                       Fill="{ThemeResource SystemControlBackgroundAccentBrush}"
                                       Visibility="Collapsed"/>
                            <ContentPresenter Content="{TemplateBinding Content}"
                                              HorizontalAlignment="Stretch"
                                              VerticalAlignment="Center"
                                              Margin="16,0,0,0"/>
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal"/>
                                    <VisualState x:Name="Pressed">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Root"
                                                                            Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame KeyTime="0"
                                                    Value="{ThemeResource SystemControlHighlightListLowBrush}"/>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Selected">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="SelectionBar"
                                                                            Storyboard.TargetProperty="Visibility">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="Visible"/>
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Root"
                                                                            Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame KeyTime="0"
                                                    Value="{ThemeResource SystemControlHighlightAccentLowBrush}"/>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="PointerOver">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Root"
                                                                            Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame KeyTime="0"
                                                    Value="{ThemeResource SystemControlHighlightListLowBrush}"/>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <!-- v261116-15: SplitView 汉堡菜单（14393 兼容）
         侧边栏用 ListView 实现左侧蓝色竖条选中样式（UWP 标准，参考 Groove/天气/邮件） -->
    <SplitView x:Name="NavSplit" IsPaneOpen="True" DisplayMode="CompactOverlay"
               OpenPaneLength="280" CompactPaneLength="48"
               PaneBackground="{ThemeResource SystemControlBackgroundAltMediumBrush}">
        <SplitView.Pane>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 顶部：汉堡按钮 + 应用标题 -->
                <Grid Grid.Row="0" Padding="0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" x:Name="HamburgerBtn" Click="HamburgerBtn_Click"
                            Width="48" Height="48" Padding="0"
                            Background="Transparent" BorderThickness="0"
                            FontFamily="Segoe MDL2 Assets" FontSize="16" Content="&#xE700;"/>
                    <TextBlock Grid.Column="1" Text="AIAnyWhere" FontSize="16"
                               FontWeight="SemiBold" VerticalAlignment="Center"
                               Margin="4,0,0,0"/>
                </Grid>

                <!-- 主菜单 ListView — 左侧蓝色竖条选中样式 -->
                <ListView x:Name="NavMenuList" Grid.Row="1"
                          SelectionMode="Single"
                          IsItemClickEnabled="True"
                          ItemClick="NavMenuList_ItemClick"
                          ContainerContentChanging="NavMenuList_ContainerContentChanging"
                          ItemContainerStyle="{StaticResource NavListItemStyle}">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Height="40">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Icon}" FontFamily="Segoe MDL2 Assets"
                                               FontSize="16" VerticalAlignment="Center" Margin="20,0,16,0"
                                               Foreground="{ThemeResource SystemControlForegroundBaseHighBrush}"/>
                                    <TextBlock Text="{Binding Title}" VerticalAlignment="Center"
                                               FontSize="14"
                                               Foreground="{ThemeResource SystemControlForegroundBaseHighBrush}"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!-- 分隔线 -->
                <Border Grid.Row="1" VerticalAlignment="Bottom"
                        Height="1" Background="{ThemeResource SystemControlForegroundBaseLowBrush}"
                        Opacity="0.3"/>

                <!-- 底部设置项 ListView -->
                <ListView x:Name="NavFooterList" Grid.Row="2"
                          SelectionMode="Single"
                          IsItemClickEnabled="True"
                          ItemClick="NavFooterList_ItemClick"
                          ContainerContentChanging="NavMenuList_ContainerContentChanging"
                          ItemContainerStyle="{StaticResource NavListItemStyle}"
                          Margin="0,8,0,8">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Height="40">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Icon}" FontFamily="Segoe MDL2 Assets"
                                               FontSize="16" VerticalAlignment="Center" Margin="20,0,16,0"
                                               Foreground="{ThemeResource SystemControlForegroundBaseHighBrush}"/>
                                    <TextBlock Text="{Binding Title}" VerticalAlignment="Center"
                                               FontSize="14"
                                               Foreground="{ThemeResource SystemControlForegroundBaseHighBrush}"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </SplitView.Pane>

        <!-- 主内容区 -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 聊天视图 — 简化为 TextBlock binding，不用 ContainerContentChanging 渲染 Markdown（修复闪退） -->
            <ListView x:Name="MessageList" Grid.Row="0" Padding="12,8"
                      SelectionMode="None"
                      IsItemClickEnabled="False"
                      HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Stretch">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Padding" Value="0,2"/>
                        <Setter Property="MinHeight" Value="0"/>
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="{Binding LeftSpacerWidth, Converter={StaticResource StarConv}}"/>
                                <ColumnDefinition Width="{Binding BubbleWidth, Converter={StaticResource StarConv}}"/>
                                <ColumnDefinition Width="{Binding RightSpacerWidth, Converter={StaticResource StarConv}}"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="1" Background="{Binding BubbleBackground}"
                                    CornerRadius="4" Padding="12,8" BorderThickness="0"
                                    Margin="0,2" HorizontalAlignment="Stretch">
                                <Border.ContextFlyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem Text="复制" Click="CopyMessage_Click" Tag="{Binding}"/>
                                        <MenuFlyoutItem Text="重新生成" Click="RegenerateMessage_Click" Tag="{Binding}"/>
                                        <MenuFlyoutItem Text="删除" Click="DeleteMessage_Click" Tag="{Binding}"/>
                                    </MenuFlyout>
                                </Border.ContextFlyout>
                                <StackPanel>
                                    <Border Visibility="{Binding ThinkingVisibility}"
                                            Background="{ThemeResource SystemControlBackgroundAltLowBrush}"
                                            CornerRadius="4" Padding="8,4" Margin="0,0,0,6">
                                        <StackPanel>
                                            <Button Content="{Binding ThinkingToggleText}"
                                                    FontSize="12" Padding="6,2" Background="Transparent"
                                                    BorderThickness="0" Click="ThinkingToggle_Click"
                                                    Tag="{Binding}"/>
                                            <TextBlock Text="{Binding Thinking}"
                                                       FontSize="12" TextWrapping="Wrap"
                                                       Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                                                       FontStyle="Italic"
                                                       Visibility="{Binding ThinkingContentVisibility, Converter={StaticResource VisConv}}"
                                                       Margin="4,4,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <!-- v261116-15: 简化为 TextBlock 直接 binding Content（修复闪退）
                                         Markdown 渲染待后续 UserControl 实现 -->
                                    <TextBlock Text="{Binding Content}" FontSize="15"
                                               TextWrapping="Wrap" LineHeight="22"
                                               Foreground="{Binding ContentForeground}"/>
                                    <TextBlock Text="{Binding RoleDisplay}" FontSize="10"
                                               Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                                               Margin="0,4,0,0" Opacity="0.6"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!-- 历史视图 -->
            <Grid x:Name="HistoryPanel" Grid.Row="0" Visibility="Collapsed" Padding="12,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="历史对话" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,12"/>
                <ListView x:Name="HistoryList" Grid.Row="1" SelectionMode="Single"
                          IsItemClickEnabled="True"
                          ItemClick="HistoryList_ItemClick">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Padding="8,6">
                                <TextBlock Text="{Binding title}" FontWeight="SemiBold" FontSize="14" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding subtitle}" FontSize="11"
                                           Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                                           Margin="0,2,0,0"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>

            <!-- 底部输入栏 -->
            <Grid Grid.Row="1" Padding="12,8" Background="{ThemeResource SystemControlBackgroundAltMediumBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="InputBox" Grid.Column="0"
                         PlaceholderText="输入消息... (Enter 发送, Shift+Enter 换行)"
                         AcceptsReturn="True" MaxHeight="120" TextWrapping="Wrap"
                         KeyDown="InputBox_KeyDown"/>
                <Button x:Name="SendBtn" Grid.Column="1" Content="发送" Margin="8,0,0,0"
                        Click="SendBtn_Click" MinWidth="80"
                        Style="{ThemeResource AccentButtonStyle}"/>
            </Grid>

            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup>
                    <VisualState x:Name="Wide">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="720"/>
                        </VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="MessageList.MaxWidth" Value="900"/>
                            <Setter Target="MessageList.HorizontalAlignment" Value="Center"/>
                            <Setter Target="HistoryPanel.MaxWidth" Value="900"/>
                            <Setter Target="HistoryPanel.HorizontalAlignment" Value="Center"/>
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Narrow">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="0"/>
                        </VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="MessageList.MaxWidth" Value="NaN"/>
                            <Setter Target="MessageList.HorizontalAlignment" Value="Stretch"/>
                            <Setter Target="HistoryPanel.MaxWidth" Value="NaN"/>
                            <Setter Target="HistoryPanel.HorizontalAlignment" Value="Stretch"/>
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
        </Grid>
    </SplitView>
</Page>
