<Page
    x:Class="AIAnyWhere.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶部栏 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Padding="12,8">
            <TextBlock Text="AIAnyWhere" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
            <Button x:Name="SettingsBtn" Content="设置" Margin="12,0,0,0" Click="SettingsBtn_Click"/>
        </StackPanel>

        <!-- 消息列表 -->
        <ListView x:Name="MessageList" Grid.Row="1" Padding="12,0">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border CornerRadius="8" Padding="12,8" Margin="0,4">
                        <StackPanel>
                            <TextBlock Text="{Binding Role}" FontSize="11" Foreground="Gray" Margin="0,0,0,2"/>
                            <TextBlock Text="{Binding Content}" FontSize="15" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- 底部输入栏 -->
        <Grid Grid.Row="2" Padding="12,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="InputBox" Grid.Column="0" PlaceholderText="输入消息..." AcceptsReturn="True" MaxHeight="100"/>
            <Button x:Name="SendBtn" Grid.Column="1" Content="发送" Margin="8,0,0,0" Click="SendBtn_Click"/>
        </Grid>
    </Grid>
</Page>
