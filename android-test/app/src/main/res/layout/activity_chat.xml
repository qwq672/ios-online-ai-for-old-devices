<?xml version="1.0" encoding="utf-8"?>
<!-- v261116-14: 拟物化主聊天布局（iOS 6 风格）
     - 顶部栏：渐变背景 + 底部金属边框
     - 列表：纹理背景
     - 底部输入栏：渐变背景 + 圆角输入框 + 胶囊发送按钮 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?android:attr/windowBackground">

    <!-- Top bar: 渐变背景拟物化 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:paddingLeft="10dp"
        android:paddingRight="6dp"
        android:gravity="center_vertical"
        android:background="@drawable/navbar_bg">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="AIAnyWhere"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="#1A1A1A"
            android:shadowColor="#40FFFFFF"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="0" />

        <Button
            android:id="@+id/clearButton"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:text="清空"
            android:textSize="13sp"
            android:textColor="#1A1A1A"
            android:minWidth="48dp"
            android:background="@android:drawable/btn_default" />

        <Button
            android:id="@+id/settingsButton"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:text="设置"
            android:textSize="13sp"
            android:textColor="#1A1A1A"
            android:minWidth="48dp"
            android:layout_marginLeft="4dp"
            android:background="@android:drawable/btn_default" />
    </LinearLayout>

    <ListView
        android:id="@+id/listView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@null"
        android:dividerHeight="0dp"
        android:padding="6dp"
        android:clipToPadding="false"
        android:transcriptMode="alwaysScroll"
        android:stackFromBottom="false"
        android:cacheColorHint="#00000000" />

    <!-- 底部输入栏：渐变背景拟物化 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="6dp"
        android:gravity="center_vertical"
        android:background="@drawable/navbar_bg">

        <EditText
            android:id="@+id/inputField"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="输入消息…"
            android:textColorHint="#808080"
            android:inputType="textMultiLine"
            android:maxLines="4"
            android:textSize="15sp"
            android:background="@drawable/input_field_skeuomorphic" />

        <Button
            android:id="@+id/sendButton"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:text="发送"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="15sp"
            android:minWidth="68dp"
            android:layout_marginLeft="6dp"
            android:background="@drawable/send_btn_skeuomorphic"
            android:shadowColor="#40000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="0" />
    </LinearLayout>
</LinearLayout>
