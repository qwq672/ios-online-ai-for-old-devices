<?xml version="1.0" encoding="utf-8"?>
<!-- v261116-14: 拟物化 AI 气泡背景（白色，iOS 6 SMS 风格） -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <gradient
                android:angle="270"
                android:startColor="#FFFFFF"
                android:endColor="#F0F0F4"
                android:type="linear" />
            <stroke android:width="1dp" android:color="#D8D8DC" />
            <padding android:left="10dp" android:right="10dp" android:top="8dp" android:bottom="8dp" />
        </shape>
    </item>
    <item android:top="1dp" android:left="3dp" android:right="3dp">
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <gradient
                android:angle="270"
                android:startColor="#60FFFFFF"
                android:endColor="#00FFFFFF"
                android:type="linear" />
            <padding android:top="2dp" android:bottom="18dp" />
        </shape>
    </item>
</layer-list>
