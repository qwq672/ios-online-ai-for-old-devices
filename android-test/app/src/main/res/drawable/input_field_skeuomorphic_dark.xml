<?xml version="1.0" encoding="utf-8"?>
<!-- v261116-14: 拟物化输入框背景（深色模式） -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="10dp" />
            <solid android:color="#1A1A1C" />
            <stroke android:width="1dp" android:color="#3A3A3C" />
            <padding android:left="8dp" android:right="8dp" android:top="6dp" android:bottom="6dp" />
        </shape>
    </item>
    <item android:top="0dp" android:left="1dp" android:right="1dp" android:height="2dp">
        <shape android:shape="rectangle">
            <corners android:topLeftRadius="10dp" android:topRightRadius="10dp" />
            <gradient
                android:angle="270"
                android:startColor="#40000000"
                android:endColor="#00000000"
                android:type="linear" />
        </shape>
    </item>
</layer-list>
