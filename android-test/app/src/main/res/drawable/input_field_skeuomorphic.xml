<?xml version="1.0" encoding="utf-8"?>
<!-- v261116-14: 拟物化输入框背景（圆角 + 内嵌阴影感） -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 外框：白色背景 + 圆角 -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="10dp" />
            <solid android:color="#FAFAFC" />
            <stroke android:width="1dp" android:color="#B8B8BC" />
            <padding android:left="8dp" android:right="8dp" android:top="6dp" android:bottom="6dp" />
        </shape>
    </item>
    <!-- 顶部阴影线（模拟内嵌凹陷感） -->
    <item android:top="0dp" android:left="1dp" android:right="1dp" android:height="2dp">
        <shape android:shape="rectangle">
            <corners android:topLeftRadius="10dp" android:topRightRadius="10dp" />
            <gradient
                android:angle="270"
                android:startColor="#20000000"
                android:endColor="#00000000"
                android:type="linear" />
        </shape>
    </item>
</layer-list>
