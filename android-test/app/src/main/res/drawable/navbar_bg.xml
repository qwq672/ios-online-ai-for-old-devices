<?xml version="1.0" encoding="utf-8"?>
<!-- v261116-14: 拟物化顶部栏背景 — 渐变 + 底部分割线 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 主渐变背景（亮色：从白到浅灰，模拟 iOS 6 navigation bar 质感） -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#F8F8F8"
                android:endColor="#D8D8DC"
                android:type="linear" />
        </shape>
    </item>
    <!-- 底部 1px 分割线（深色细线，模拟金属边框） -->
    <item android:bottom="-1dp">
        <shape android:shape="rectangle">
            <solid android:color="#A8A8AC" />
            <padding android:bottom="1dp" />
        </shape>
    </item>
</layer-list>
