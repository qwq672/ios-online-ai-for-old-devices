<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Light theme -->
    <style name="AppTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">#EDEDED</item>
        <item name="android:textColor">#1A1A1A</item>
        <item name="android:textColorSecondary">#666666</item>
    </style>

    <!-- Dark theme -->
    <style name="AppTheme.Dark" parent="@android:style/Theme.NoTitleBar">
        <item name="android:windowBackground">#070707</item>
        <item name="android:textColor">#D8D8E0</item>
        <item name="android:textColorSecondary">#7A8298</item>
    </style>

    <!-- Color palette -->
    <color name="bg_light">#EDEDED</color>
    <color name="bg_dark">#070707</color>
    <color name="topbar_light">#F5F5F5</color>
    <color name="topbar_dark">#111111</color>
    <color name="input_bg_light">#FFFFFF</color>
    <color name="input_bg_dark">#151515</color>
    <color name="bubble_user_light">#DCF8C6</color>
    <color name="bubble_user_dark">#151515</color>
    <color name="bubble_ai_light">#FFFFFF</color>
    <color name="bubble_ai_dark">#0F0F0F</color>
    <color name="text_light">#1A1A1A</color>
    <color name="text_dark">#D8D8E0</color>
    <color name="text_secondary_light">#666666</color>
    <color name="text_secondary_dark">#7A8298</color>
    <color name="tint">#1E3A8A</color>
    <color name="code_bg_light">#F5F5F5</color>
    <color name="code_bg_dark">#111111</color>
</resources>
